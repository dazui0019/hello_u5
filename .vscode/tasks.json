{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Debug: Prepare GDB",
            "type": "process",
            "command": "arm-none-eabi-gdb",
            "args": ["--batch", "--nx", "--quiet", "-ex", "show version"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build Debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [{
                "owner": "cpp",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }]
        },
        {
            "label": "CMake: Rebuild Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug", "--clean-first"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure Debug",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [{
                "owner": "cpp",
                "source": "gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }]
        },
        {
            "label": "pyOCD: RTT",
            "type": "process",
            "command": "pyocd",
            "args": [
                "rtt",
                "--target", "stm32u585ciux",
                "--frequency", "10000000",
                "--no-wait",
                "--connect", "attach",
                "--address", "0x20000000",
                "--size", "0xC0000",
                "--up-channel-id", "0",
                "--down-channel-id", "0"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": []
        },
        {
            "label": "pyOCD: Flash Debug",
            "type": "process",
            "command": "pyocd",
            "args": [
                "flash",
                "--target", "stm32u585ciux",
                "--frequency", "10000000",
                "--no-wait",
                "${workspaceFolder}/build/Debug/hello_u5.elf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build Debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
