{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CubeMX: Open Project",
            "type": "process",
            "command": "D:/ProgramFiles/STMicroelectronics/STM32CubeMX/STM32CubeMX.exe",
            "args": [
                "${workspaceFolder}/hello_u5.ioc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": []
        },
        {
            "label": "Debug: Prepare GDB",
            "type": "process",
            "command": "arm-none-eabi-gdb",
            "args": [
                "--batch",
                "--nx",
                "--quiet",
                "-ex",
                "show version"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build Debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "source": "gcc",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "CMake: Rebuild Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--clean-first"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Configure Debug",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "source": "gcc",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "Unity: Configure Host Tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "test",
                "-B", "build/host-tests",
                "-G", "Ninja",
                "-DCMAKE_C_COMPILER=gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "hide": true,
            "problemMatcher": []
        },
        {
            "label": "Unity: Build Host Tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "build/host-tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Unity: Configure Host Tests",
            "hide": true,
            "problemMatcher": []
        },
        {
            "label": "Unity: Run Host Tests",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir", "build/host-tests",
                "--verbose",
                "--no-tests=error"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Unity: Build Host Tests",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "OpenOCD: Flash Debug",
            "type": "process",
            "command": "${config:cortex-debug.openocdPath}",
            "args": [
                "-f",
                "${workspaceFolder}/.vscode/openocd.cfg",
                "-c",
                "program {build/Debug/hello_u5.elf} verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build Debug",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
