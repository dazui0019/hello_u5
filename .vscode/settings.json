{
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.useCMakePresets": "always",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/Debug"
    ],
    "cortex-debug.variableUseNaturalFormat": false,
    "actionButtons": {
        "defaultColor": "none",
        "reloadButton": null,
        "loadNpmCommands": false,
        "inheritGlobalCommands": false,
        "commands": [
            {
                "name": "$(tools) 编译 Debug",
                "tooltip": "保存文件并配置、编译 Debug 固件",
                "saveAll": true,
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "CMake: Build Debug"
                ]
            },
            {
                "name": "$(refresh) Rebuild",
                "tooltip": "保存文件，清理 Debug 构建产物并全量重新编译",
                "saveAll": true,
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "CMake: Rebuild Debug"
                ]
            },
            {
                "name": "$(arrow-down) 下载 Debug",
                "tooltip": "编译 Debug 固件并通过 OpenOCD 下载到 STM32U585",
                "saveAll": true,
                "useVsCodeApi": true,
                "command": "workbench.action.tasks.runTask",
                "args": [
                    "OpenOCD: Flash Debug"
                ]
            },
            {
                "name": "$(debug-alt) 调试 / RTT",
                "tooltip": "启动当前选中的 OpenOCD 调试配置；Debug + RTT 会自动打开 RTT 控制台",
                "saveAll": true,
                "useVsCodeApi": true,
                "command": "workbench.action.debug.start"
            }
        ]
    },
    "cortex-debug.openocdPath": "D:/Toolchain/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe"
}
