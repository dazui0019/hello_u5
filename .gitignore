# CMake / Ninja 构建目录
/build/
/cmake-build-*/
/Debug/
/Release/

# 在源码目录内运行 CMake 时生成的文件
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/build.ninja
/rules.ninja
/.ninja_deps
/.ninja_log
/compile_commands.json
/CMakeUserPresets.json

# 编译、链接产物
*.o
*.obj
*.elf
*.axf
*.map
*.su
*.cyclo
*.d
# 根目录导出的固件；保留第三方目录中可能需要的预编译资源
/*.hex
/*.bin

# 编辑器索引、调试日志；保留 .vscode 下的共享配置
/.cache/
/ipch/
/.vscode/ipch/
/.vscode/.browse.VC*
*.log

# 临时文件与备份
*.tmp
*.bak
*.swp
*.swo
*~

# 操作系统生成的文件
.DS_Store
Thumbs.db
Desktop.ini
